{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start OpenOCD",
            "type": "shell",
            "command": "/opt/toolchains/zephyr-sdk-0.16.8/sysroots/x86_64-pokysdk-linux/usr/bin/openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-c", "transport select hla_swd",
                "-c", "adapter speed 1000",
                "-f", "target/stm32f4x.cfg"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Open On-Chip Debugger",
                    "endsPattern": "Listening on port 3333"
                }
            },
            "presentation": { "reveal": "silent" }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "bash",
            "args":
            [
                "-lc",
                "cd /workspace/apps/${input:prjChoice} && west build -p always -b ${input:brdChoice} -- -DDTC_OVERLAY_FILE=boards/${input:brdChoice}.overlay"
            ],
            "options": {
                "env": {
                    "ZEPHYR_BASE": "/opt/toolchains/zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/toolchains/zephyr-sdk-0.16.8",
                    "WEST_TOPDIR": "/opt/toolchains"
                }
            }
        }
    ],
    "inputs": 
    [
        {
            "id": "prjChoice",
            "type": "pickString",
            "description": "Choose project",
            "options": 
            [
                "01_blink",
                "04_solution_button_led",
                "05_demo_adc",
                "05_solution_pwm_knob",
                "06_demo_device_driver",
                "09_demo_gpio_interrupt",
                "09_demo_counter_interrupt"
            ],
            "default": "dev"
        },
        {
            "id": "brdChoice",
            "type": "pickString",
            "description": "Choose board",
            "options": 
            [
                "blackpill_f411ce",
                "esp32c6_devkitc",
            ],
            "default": "blackpill_f411ce"
        }
    ],
}