{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "bash",
            "args": 
            [
                "-lc",
                "cd /workspace/apps/${input:prjChoice} && west build -p always -b ${input:brdChoice} -- -DDTC_OVERLAY_FILE=boards/${input:brdChoice}.overlay"
            ],
        }
    ],
    "inputs": 
    [
        {
            "id": "prjChoice",
            "type": "pickString",
            "description": "Choose project",
            "options": 
            [
                "01_blink",
                "04_solution_button_led",
                "05_demo_adc",
                "05_solution_pwm_knob",
                "06_demo_device_driver"
            ],
            "default": "dev"
        },
        {
            "id": "brdChoice",
            "type": "pickString",
            "description": "Choose board",
            "options": 
            [
                "blackpill_f411ce",
                "esp32c6_devkitc",
            ],
            "default": "blackpill_f411ce"
        }
    ],
}